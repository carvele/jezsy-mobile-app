DROP TRIGGER IF EXISTS on_auth_user_phone_changed ON auth.users;
DROP FUNCTION IF EXISTS public.handle_user_phone_change();
DROP INDEX IF EXISTS public.idx_profiles_phone_unique;

CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = 'public', 'pg_temp'
AS $$
BEGIN
  INSERT INTO public.profiles (id, email, role, created_at, updated_at)
  VALUES (NEW.id, NEW.email, 'customer', pg_catalog.now(), pg_catalog.now())
  ON CONFLICT (id) DO NOTHING;

  RETURN NEW;
END;
$$;
