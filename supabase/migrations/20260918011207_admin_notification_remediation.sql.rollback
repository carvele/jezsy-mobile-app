-- 1. Remove from realtime publication
DO $$
BEGIN
    IF EXISTS (
        SELECT 1 FROM pg_publication_tables
        WHERE pubname = 'supabase_realtime' AND schemaname = 'public' AND tablename = 'admin_notification_receipts'
    ) THEN
        ALTER PUBLICATION supabase_realtime DROP TABLE public.admin_notification_receipts;
    END IF;
END $$;

-- 2. Drop RPCs
DROP FUNCTION IF EXISTS public.dismiss_admin_notifications(UUID[]);
DROP FUNCTION IF EXISTS public.mark_admin_notifications_read(UUID[]);
DROP FUNCTION IF EXISTS public.get_unread_notification_count();

-- 3. Drop View
DROP VIEW IF EXISTS public.admin_user_notifications_view;

-- 4. Drop trigger and function
DROP TRIGGER IF EXISTS trg_fanout_admin_notification_insert ON public.admin_notifications;
DROP FUNCTION IF EXISTS public.trg_fanout_admin_notification();

-- 5. Revert RLS on admin_notifications
DROP POLICY IF EXISTS "Admins can view admin notifications" ON public.admin_notifications;
REVOKE ALL ON public.admin_notifications FROM anon, authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON public.admin_notifications TO authenticated;

CREATE POLICY "Admins can manage admin notifications" ON public.admin_notifications
FOR ALL
TO authenticated
USING (public.is_staff_or_admin());

-- 6. Remove columns from admin_notifications
ALTER TABLE public.admin_notifications
DROP COLUMN IF EXISTS event_key,
DROP COLUMN IF EXISTS actor_id,
DROP COLUMN IF EXISTS entity_type,
DROP COLUMN IF EXISTS entity_id,
DROP COLUMN IF EXISTS data,
DROP COLUMN IF EXISTS priority;

-- 7. Drop receipts table
DROP TABLE IF EXISTS public.admin_notification_receipts;

-- 8. Drop indexes
DROP INDEX IF EXISTS public.idx_admin_notification_receipts_unread;
DROP INDEX IF EXISTS public.idx_admin_notifications_created_at;
