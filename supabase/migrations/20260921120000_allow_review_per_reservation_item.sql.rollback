-- Rollback for 20260921120000_allow_review_per_reservation_item.sql

ALTER TABLE public.reviews
  DROP CONSTRAINT IF EXISTS reviews_reservation_item_unique;

DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_constraint WHERE conname = 'reviews_product_user_key'
  ) THEN
    ALTER TABLE public.reviews
      ADD CONSTRAINT reviews_product_user_key UNIQUE (product_id, user_id);
  END IF;
END $$;
