# Environment variables required for local development
# Do NOT commit actual secret values. Copy this file to .env and fill in the values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Error/crash reporting (src/utils/sentry.ts) -- app runs identically
# without it, just with no error reporting. A Sentry DSN is not a secret (it's
# baked into the client bundle either way), but keep it out of source control
# for the usual reason: easy to rotate if it ever needs to be.
EXPO_PUBLIC_SENTRY_DSN=

# Optional server-only key for Supabase functions and migrations.
# This should never be included in client-side app builds.
SUPABASE_SERVICE_ROLE_KEY=
